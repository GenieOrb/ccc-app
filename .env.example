# Base Database URL (Neon PostgreSQL WebSocket connection string)
DATABASE_URL=replace_with_neon_database_url

# Base Application URL (Canonical URL for production, without trailing slash)
APP_BASE_URL=https://your-domain.example

# OpenAI API Settings
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5.4

# Gemini API Settings
GOOGLE_AI_API_KEY=replace_with_google_ai_api_key
MEME_ANALYSIS_MODEL=gemini-3.1-flash-lite
MEME_VALIDATION_MODEL=gemini-3.1-flash-lite

# Optional generation providers. DASHSCOPE_API_KEY takes priority over legacy QWEN_API_KEY.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=replace_with_dashscope_api_key
# Full Frankfurt workspace compatible-mode endpoint; do not expose it to clients.
QWEN_BASE_URL=https://your-workspace.eu-central-1.maas.aliyuncs.com/compatible-mode/v1

# Official X (Twitter) API v2 Bearer Token
X_BEARER_TOKEN=replace_with_x_bearer_token

# Admin Security Settings
# Generate hash using: npm run admin:hash-password
ADMIN_PASSWORD_HASH=replace_with_scrypt_hash
# Random string of at least 32 bytes for signing admin session cookies
ADMIN_SESSION_SECRET=replace_with_random_secret

# Visitor Cookie Security
# Random string of at least 32 bytes for signing visitor identification cookies
VISITOR_COOKIE_SECRET=replace_with_random_secret

# General Security & Rate Limit Pseudonymization
# Random string of at least 32 bytes for HMAC calculations (IP rate limiting & visitor DB pseudonymization)
SECURITY_HMAC_SECRET=replace_with_random_secret

# Internal Background Worker Processing Secret
# Shared bearer token for calling POST /api/internal/generation/process externally
INTERNAL_PROCESS_SECRET=replace_with_random_secret

# Vercel Cron Secret
# Used to secure cron job endpoints
CRON_SECRET=replace_with_internal_process_secret
